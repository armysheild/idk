# Backend
VAHANA_ENVIRONMENT=development
VAHANA_DATABASE_URL=sqlite:///./vahana.db
VAHANA_AUTH_PROVIDER=local
VAHANA_STORAGE_BACKEND=local
VAHANA_CORS_ORIGINS=http://localhost:5173
VAHANA_TELEMATICS_CRON_SECRET=replace-with-a-long-random-secret

# Supabase production
# VAHANA_DATABASE_URL=postgresql://...
# VAHANA_AUTH_PROVIDER=supabase
# VAHANA_SUPABASE_URL=https://<project>.supabase.co
# VAHANA_SUPABASE_SERVICE_ROLE_KEY=
# VAHANA_SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# VAHANA_SUPABASE_STORAGE_BUCKET=documents
# VAHANA_STORAGE_BACKEND=supabase

# Razorpay production
# VAHANA_RAZORPAY_KEY_ID=
# VAHANA_RAZORPAY_KEY_SECRET=
# VAHANA_RAZORPAY_WEBHOOK_SECRET=
# VAHANA_RAZORPAY_PLAN_STARTER=
# VAHANA_RAZORPAY_PLAN_GROWTH=
# VAHANA_RAZORPAY_PLAN_SCALE=

