{
  "outputDirectory": "dist/public",
  "crons": [
    {
      "path": "/api/v1/telematics/cron-sync",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/signup",
      "destination": "/?page=signup"
    },
    {
      "source": "/app",
      "destination": "/?page=app"
    },
    {
      "source": "/invite/:token",
      "destination": "/?page=invite&token=:token"
    },
    {
      "source": "/health",
      "destination": "/api?path=/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?path=/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
